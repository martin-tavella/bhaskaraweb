---
// BhaskaraCalculator.astro - Componente de renderizado para la calculadora de Bhaskara

const coefficients = [
  { id: 'input-a', name: 'a', hint: 'término cuadrático', placeholder: '1', enterKey: 'next' },
  { id: 'input-b', name: 'b', hint: 'término lineal', placeholder: '-5', enterKey: 'next' },
  { id: 'input-c', name: 'c', hint: 'término independiente', placeholder: '6', enterKey: 'go' },
];

const options = [
  {
    name: 'domain',
    label: 'Conjunto',
    choices: [
      { value: 'real', text: 'Reales', symbol: 'ℝ', checked: true },
      { value: 'complex', text: 'Complejos', symbol: 'ℂ' },
    ],
  },
  {
    name: 'format',
    label: 'Formato',
    choices: [
      { value: 'fractional', text: 'Exacto', checked: true },
      { value: 'decimal', text: 'Decimal' },
    ],
  },
];

const examples = [
  { a: 1, b: -5, c: 6, domain: 'real', label: 'x² − 5x + 6', note: 'dos raíces' },
  { a: 1, b: 0, c: -2, domain: 'real', label: 'x² − 2', note: 'con radicales' },
  { a: 1, b: 2, c: 5, domain: 'complex', label: 'x² + 2x + 5', note: 'complejas' },
  { a: 1, b: -4, c: 4, domain: 'real', label: 'x² − 4x + 4', note: 'raíz doble' },
];

const segmentBase =
  'block rounded-lg px-3 py-2 text-center text-sm font-semibold text-ink/60 transition duration-300 ease-fluid hover:text-ink peer-checked:bg-ink peer-checked:text-paper peer-focus-visible:ring-2 peer-focus-visible:ring-accent peer-focus-visible:ring-offset-2';
---

<div class="grid grid-cols-1 gap-4 lg:grid-cols-5 lg:items-start">
  <!-- Entrada de datos -->
  <form
    id="bhaskara-form"
    class="flex flex-col gap-6 rounded-2xl border border-ink/10 bg-white p-4 shadow-sm sm:gap-8 sm:p-8 lg:col-span-3"
    novalidate
  >
    <fieldset class="flex flex-col gap-4">
      <legend class="sr-only sm:not-sr-only sm:mb-4 sm:font-serif sm:text-2xl sm:font-medium">Coeficientes</legend>

      <div class="grid grid-cols-3 gap-2 sm:gap-4">
        {coefficients.map((coef) => (
          <label for={coef.id} class="flex flex-col gap-2">
            <span class="flex flex-wrap items-baseline gap-x-2">
              <span class="font-serif text-3xl leading-none text-accent">{coef.name}</span>
              <span class="hidden text-xs font-medium text-ink/50 sm:inline">{coef.hint}</span>
            </span>
            <input
              type="number"
              step="any"
              id={coef.id}
              name={coef.name}
              required
              autocomplete="off"
              enterkeyhint={coef.enterKey}
              placeholder={coef.placeholder}
              class="coef-input h-14 w-full min-w-0 rounded-xl border-2 border-ink/20 bg-paper/50 px-3 text-xl font-semibold tabular-nums text-ink outline-none transition duration-300 ease-fluid placeholder:font-normal placeholder:text-ink/25 hover:border-ink/40 focus:border-accent focus:bg-white focus:ring-4 focus:ring-accent/15 sm:h-16 sm:px-4 sm:text-2xl"
            />
          </label>
        ))}
      </div>

      <!-- Vista previa de la ecuación ingresada -->
      <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-xl bg-paper/70 px-4 py-2 sm:py-3">
        <span class="text-xs font-semibold text-ink/50">Tu ecuación</span>
        <span id="equation-preview" class="font-serif text-lg tabular-nums sm:text-xl">ax² + bx + c = 0</span>
      </p>
    </fieldset>

    <!-- Opciones: en mobile una fila por opción, desde sm en dos columnas -->
    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 sm:gap-4">
      {options.map((opt) => (
        <div
          role="radiogroup"
          aria-labelledby={`label-${opt.name}`}
          class="flex items-center justify-between gap-4 sm:flex-col sm:items-stretch sm:gap-2"
        >
          <span id={`label-${opt.name}`} class="text-xs font-semibold text-ink/60 sm:text-sm sm:text-ink/70">
            {opt.label}
          </span>
          <div class="grid w-52 grid-cols-2 gap-1 rounded-xl border border-ink/10 bg-paper/60 p-1 sm:w-auto">
            {opt.choices.map((choice) => (
              <label class="cursor-pointer">
                <input type="radio" name={opt.name} value={choice.value} checked={choice.checked} class="peer sr-only" />
                <span class={segmentBase}>
                  {choice.text}
                  {choice.symbol && <span class="hidden sm:inline"> {choice.symbol}</span>}
                </span>
              </label>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Acciones -->
    <div class="flex flex-col gap-4">
      <div class="flex gap-2">
        <button
          type="submit"
          class="flex-1 cursor-pointer rounded-xl bg-accent px-3 py-3 text-base font-semibold text-white transition duration-300 ease-fluid hover:bg-accent-strong active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
        >
          Calcular raíces
        </button>
        <button
          type="button"
          id="btn-clear"
          class="cursor-pointer rounded-xl border border-ink/15 px-4 py-3 text-base font-semibold text-ink/70 transition duration-300 ease-fluid hover:border-ink/30 hover:text-ink active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/40 focus-visible:ring-offset-2 sm:px-6"
        >
          Limpiar
        </button>
      </div>

      <!-- Ejemplos: solo desde tablet, en mobile se prioriza ir directo al cálculo -->
      <div class="hidden flex-wrap items-center gap-2 sm:flex">
        <span class="mr-1 text-xs font-semibold text-ink/50">Prueba con</span>
        {examples.map((ex) => (
          <button
            type="button"
            class="example-btn cursor-pointer rounded-lg border border-ink/10 px-2 py-1 text-xs text-ink/70 transition duration-300 ease-fluid hover:border-accent/40 hover:text-accent active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            data-a={ex.a}
            data-b={ex.b}
            data-c={ex.c}
            data-domain={ex.domain}
            data-format="fractional"
          >
            <span class="font-serif text-sm">{ex.label}</span>
            <span class="text-ink/40"> · {ex.note}</span>
          </button>
        ))}
      </div>
    </div>
  </form>

  <!-- Resultados: panel oscuro tipo pantalla -->
  <section
    id="results-container"
    aria-live="polite"
    class="scroll-mt-4 rounded-2xl bg-ink p-4 text-paper shadow-lg sm:p-8 lg:sticky lg:top-6 lg:col-span-2"
  >
    <h2 class="mb-4 font-serif text-xl font-medium sm:text-2xl">Resultado</h2>

    <!-- Estado inicial -->
    <div
      id="initial-placeholder"
      class="rounded-xl border border-dashed border-paper/20 px-4 py-6 text-center sm:py-8"
    >
      <p class="font-serif text-2xl text-paper/30 sm:text-3xl">x₁ = ? &nbsp; x₂ = ?</p>
      <p class="mt-2 text-sm text-paper/50">
        Completa <span class="text-accent-soft">a</span>, <span class="text-accent-soft">b</span>{' y '}<span class="text-accent-soft">c</span> y presiona calcular.
      </p>
    </div>

    <!-- Contenedor dinámico de resultados (se llena con JS) -->
    <div id="results-content" class="hidden flex-col gap-4">
      <!-- Raíces: lo primero que se ve -->
      <div id="roots-grid" class="grid grid-cols-1 gap-2"></div>

      <!-- Alerta de error o advertencia -->
      <div id="alert-box" class="hidden rounded-xl border p-4 text-sm"></div>

      <!-- Sugerencia de pasar a complejos si Δ < 0 en reales -->
      <div
        id="switch-to-complex-banner"
        class="hidden flex-col items-start gap-4 rounded-xl border border-paper/10 p-4 sm:flex-row sm:items-center sm:justify-between lg:flex-col lg:items-start"
      >
        <p class="text-sm text-paper/70">Esta ecuación sí tiene solución en los números complejos.</p>
        <button
          type="button"
          id="btn-switch-complex"
          class="shrink-0 cursor-pointer rounded-lg bg-accent px-3 py-2 text-sm font-semibold text-white transition duration-300 ease-fluid hover:bg-accent-strong active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-soft focus-visible:ring-offset-2 focus-visible:ring-offset-ink"
        >
          Calcular en ℂ
        </button>
      </div>

      <!-- Discriminante: detalle secundario -->
      <div
        id="discriminant-box"
        class="flex flex-col items-start gap-2 rounded-xl border border-paper/10 bg-paper/5 p-4"
      >
        <div class="text-xs font-semibold text-paper/50">Discriminante</div>
        <div id="discriminant-formula" class="font-serif text-lg tabular-nums">Δ = b² − 4ac</div>
        <span id="discriminant-badge" class="rounded-full px-3 py-1 text-xs font-semibold"></span>
      </div>
    </div>
  </section>
</div>

<script>
  import { calculateBhaskara } from '../../calculator/bhaskara.js';

  // Referencias a los elementos del DOM
  const form = document.getElementById('bhaskara-form');
  const inputA = document.getElementById('input-a');
  const inputB = document.getElementById('input-b');
  const inputC = document.getElementById('input-c');
  const coefInputs = [inputA, inputB, inputC];
  const equationPreview = document.getElementById('equation-preview');
  const btnClear = document.getElementById('btn-clear');
  const exampleButtons = document.querySelectorAll('.example-btn');

  const resultsContainer = document.getElementById('results-container');
  const initialPlaceholder = document.getElementById('initial-placeholder');
  const resultsContent = document.getElementById('results-content');
  const discriminantBox = document.getElementById('discriminant-box');
  const discriminantFormula = document.getElementById('discriminant-formula');
  const discriminantBadge = document.getElementById('discriminant-badge');
  const alertBox = document.getElementById('alert-box');
  const rootsGrid = document.getElementById('roots-grid');
  const switchToComplexBanner = document.getElementById('switch-to-complex-banner');
  const btnSwitchComplex = document.getElementById('btn-switch-complex');

  const BADGE_BASE = 'rounded-full px-3 py-1 text-xs font-semibold';
  const ALERT_BASE = 'rounded-xl border p-4 text-sm';

  // Muestra u oculta un contenedor flex
  function setVisible(el, visible) {
    el.classList.toggle('hidden', !visible);
    el.classList.toggle('flex', visible);
  }

  // Actualiza la visualización de la ecuación matemática en tiempo real
  function updateEquationPreview() {
    const aVal = inputA.value.trim();
    const bVal = inputB.value.trim();
    const cVal = inputC.value.trim();

    if (!aVal && !bVal && !cVal) {
      equationPreview.textContent = 'ax² + bx + c = 0';
      return;
    }

    const a = aVal !== '' ? aVal : 'a';
    const b = bVal !== '' ? (Number(bVal) >= 0 ? `+ ${bVal}` : `− ${Math.abs(Number(bVal))}`) : '+ b';
    const c = cVal !== '' ? (Number(cVal) >= 0 ? `+ ${cVal}` : `− ${Math.abs(Number(cVal))}`) : '+ c';

    equationPreview.textContent = `${a}x² ${b}x ${c} = 0`;
  }

  coefInputs.forEach((input, index) => {
    input.addEventListener('input', updateEquationPreview);

    // Al enfocar se selecciona el valor para poder reemplazarlo de una
    input.addEventListener('focus', () => input.select());

    // Enter en a o b pasa al siguiente coeficiente; en c envía el formulario
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && index < coefInputs.length - 1) {
        e.preventDefault();
        coefInputs[index + 1].focus();
      }
    });
  });

  function showAlert(tone, title, text) {
    const tones = {
      error: 'border-rose-300/30 bg-rose-400/10 text-rose-100',
      warning: 'border-amber-300/30 bg-amber-300/10 text-amber-100',
    };
    alertBox.className = `${ALERT_BASE} ${tones[tone]}`;
    alertBox.innerHTML = `
      <div class="font-semibold">${title}</div>
      <p class="mt-1 opacity-80">${text}</p>
    `;
  }

  // Reinicia la animación de aparición del panel de resultados
  function replayReveal() {
    resultsContent.classList.remove('reveal');
    void resultsContent.offsetWidth;
    resultsContent.classList.add('reveal');
  }

  // Lleva el panel de resultados a la vista si no se ve completo (mobile y tablet)
  function bringResultsIntoView() {
    requestAnimationFrame(() => {
      const rect = resultsContainer.getBoundingClientRect();
      if (rect.top < 0 || rect.bottom > window.innerHeight) {
        resultsContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  }

  // Ejecución del cálculo
  function runCalculation() {
    const rawA = inputA.value.trim();
    const rawB = inputB.value.trim();
    const rawC = inputC.value.trim();

    const domain = form.querySelector('input[name="domain"]:checked')?.value || 'real';
    const format = form.querySelector('input[name="format"]:checked')?.value || 'fractional';

    initialPlaceholder.classList.add('hidden');
    setVisible(resultsContent, true);
    setVisible(discriminantBox, true);
    setVisible(switchToComplexBanner, false);
    alertBox.classList.add('hidden');
    rootsGrid.classList.remove('hidden');
    replayReveal();

    const result = calculateBhaskara(rawA, rawB, rawC, { domain, format });

    if (!result.success) {
      // Error de validación (por ej: a = 0 o campos vacíos)
      setVisible(discriminantBox, false);
      rootsGrid.classList.add('hidden');
      showAlert('error', 'No se pudo calcular', result.error);
      return;
    }

    const { discriminant, roots, hasRealRoots, isDoubleRoot, message } = result;

    // Actualizar discriminante
    discriminantFormula.textContent = `Δ = (${result.inputs.b})² − 4(${result.inputs.a})(${result.inputs.c}) = ${discriminant}`;

    if (discriminant > 0) {
      discriminantBadge.className = `${BADGE_BASE} bg-emerald-400/15 text-emerald-200`;
      discriminantBadge.textContent = 'Δ > 0 · dos raíces reales distintas';
    } else if (discriminant === 0) {
      discriminantBadge.className = `${BADGE_BASE} bg-sky-400/15 text-sky-200`;
      discriminantBadge.textContent = 'Δ = 0 · una raíz real doble';
    } else {
      discriminantBadge.className = `${BADGE_BASE} bg-amber-300/15 text-amber-200`;
      discriminantBadge.textContent = domain === 'complex'
        ? 'Δ < 0 · dos raíces complejas conjugadas'
        : 'Δ < 0 · sin soluciones reales';
    }

    // Manejar caso de raíces reales inexistentes
    if (domain === 'real' && !hasRealRoots) {
      rootsGrid.classList.add('hidden');
      showAlert('warning', 'Sin raíces reales', message);
      setVisible(switchToComplexBanner, true);
      return;
    }

    // Renderizar tarjetas de las raíces
    rootsGrid.innerHTML = '';
    const isSingle = isDoubleRoot || roots.length === 1;
    rootsGrid.className = isSingle ? 'grid grid-cols-1 gap-2' : 'grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-1';

    roots.forEach((root) => {
      const rootCard = document.createElement('div');
      rootCard.className = 'flex flex-wrap items-center gap-x-4 gap-y-2 rounded-xl border border-paper/15 bg-paper/5 p-4';

      let valueDisplay;
      if (root.rawMath && root.rawMath !== root.math) {
        valueDisplay = `
          <div class="text-3xl text-paper">${root.math}</div>
          <div class="flex items-center gap-2 text-paper/50">
            <span class="text-xs">sin simplificar</span>
            <span class="text-xl">${root.rawMath}</span>
          </div>
        `;
      } else {
        valueDisplay = `<div class="text-3xl text-paper">${root.math || root.value}</div>`;
      }

      rootCard.innerHTML = `
        <div class="w-full text-xs font-semibold text-accent-soft">${root.name}</div>
        ${valueDisplay}
      `;
      rootsGrid.appendChild(rootCard);
    });
  }

  // Escuchar envío del formulario
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    // Cierra el teclado en mobile para que el resultado quede a la vista
    if (document.activeElement instanceof HTMLElement) document.activeElement.blur();
    runCalculation();
    bringResultsIntoView();
  });

  // Recalcular automáticamente al cambiar dominio o formato si ya se ingresaron datos
  form.querySelectorAll('input[name="domain"], input[name="format"]').forEach((radio) => {
    radio.addEventListener('change', () => {
      if (inputA.value.trim() !== '') {
        runCalculation();
      }
    });
  });

  // Botón Limpiar
  btnClear.addEventListener('click', () => {
    form.reset();
    updateEquationPreview();
    initialPlaceholder.classList.remove('hidden');
    setVisible(resultsContent, false);
    inputA.focus();
  });

  // Botones de ejemplos rápidos
  exampleButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      inputA.value = btn.dataset.a;
      inputB.value = btn.dataset.b;
      inputC.value = btn.dataset.c;

      const domainRadio = form.querySelector(`input[name="domain"][value="${btn.dataset.domain}"]`);
      if (domainRadio) domainRadio.checked = true;

      const formatRadio = form.querySelector(`input[name="format"][value="${btn.dataset.format}"]`);
      if (formatRadio) formatRadio.checked = true;

      updateEquationPreview();
      runCalculation();
      bringResultsIntoView();
    });
  });

  // Botón para cambiar a números complejos directamente
  btnSwitchComplex.addEventListener('click', () => {
    const complexRadio = form.querySelector('input[name="domain"][value="complex"]');
    if (complexRadio) {
      complexRadio.checked = true;
      runCalculation();
    }
  });

  updateEquationPreview();
</script>

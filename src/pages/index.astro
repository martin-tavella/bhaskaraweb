---
import '../styles/global.css';
import BhaskaraCalculator from '../components/BhaskaraCalculator.astro';
---

<!doctype html>
<html lang="es" class="h-full">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Fórmula de Bhaskara | Calculadora de Ecuaciones Cuadráticas</title>
    <meta
      name="description"
      content="Calculadora interactiva de la fórmula de Bhaskara. Resuelve ecuaciones cuadráticas paso a paso en números reales y complejos con raíces exactas o decimales."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap"
    />
  </head>

  <body class="min-h-full font-sans text-ink antialiased selection:bg-accent selection:text-white">
    <main class="mx-auto w-full max-w-2xl px-4 py-6 sm:py-16 lg:max-w-5xl">
      <header class="mb-6 flex flex-col gap-3 sm:mb-12 sm:gap-4">
        <h1 class="font-serif text-4xl font-medium tracking-tight sm:text-6xl">
          Fórmula de{' '}<span class="relative inline-block text-accent">
            Bhaskara
            <svg
              class="title-underline absolute -bottom-2 left-0 h-3 w-full text-accent/70"
              viewBox="0 0 200 12"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path
                d="M2 8 C 40 3, 90 2, 130 5 S 185 9, 198 4"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                pathLength="1"
              />
            </svg>
          </span>
        </h1>

        <p class="hidden max-w-lg text-base text-ink/70 sm:block">
          Ingresa los coeficientes de tu ecuación de segundo grado y obtén sus raíces,
          en números reales o complejos.
        </p>

        <math display="inline" class="self-start text-lg text-ink/70 sm:text-2xl">
          <mi>x</mi>
          <mo>=</mo>
          <mfrac>
            <mrow>
              <mo>-</mo><mi>b</mi>
              <mo>±</mo>
              <msqrt>
                <mrow>
                  <msup><mi>b</mi><mn>2</mn></msup>
                  <mo>-</mo>
                  <mn>4</mn><mi>a</mi><mi>c</mi>
                </mrow>
              </msqrt>
            </mrow>
            <mrow>
              <mn>2</mn><mi>a</mi>
            </mrow>
          </mfrac>
        </math>
      </header>

      <BhaskaraCalculator />
    </main>
  </body>
</html>
